<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:OpenUtau.App.Controls">
  <!-- Keep the Avalonia 12.1.3 Fluent templates and their keyboard, focus and drag handling.
       PART_SwitchKnob.Width is knob travel, not the width of the visible switch track. -->
  <Style>
    <Style.Resources>
      <GridLength x:Key="ToggleSwitchPreContentMargin">4</GridLength>
      <GridLength x:Key="ToggleSwitchPostContentMargin">4</GridLength>
    </Style.Resources>
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource MaterialOnSurfaceVariantBrush}"/>
  </Style>
  <Style Selector="ToggleSwitch:checked, ToggleSwitch:unchecked">
    <Style Selector="^ /template/ Border#OuterBorder, ^ /template/ Border#SwitchKnobBounds">
      <Setter Property="Width" Value="52"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="CornerRadius" Value="16"/>
    </Style>
    <Style Selector="^ /template/ Canvas#PART_SwitchKnob">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="32"/>
    </Style>
    <Style Selector="^ /template/ Grid#PART_MovingKnobs">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
    </Style>
    <Style Selector="^ /template/ Ellipse#SwitchKnobOff">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Fill" Value="{DynamicResource MaterialOnSurfaceVariantBrush}"/>
    </Style>
    <Style Selector="^ /template/ Ellipse#SwitchKnobOn">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="Fill" Value="{DynamicResource MaterialOnPrimaryBrush}"/>
    </Style>
  </Style>
  <Style Selector="ToggleSwitch:unchecked /template/ Border#OuterBorder">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerHighBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MaterialOnSurfaceVariantBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MaterialPrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style Selector="ToggleSwitch:pointerover /template/ Border#OuterBorder">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerBrush}"/>
  </Style>
  <Style Selector="ToggleSwitch:checked:pointerover /template/ Ellipse#SwitchKnobOn">
    <Setter Property="Fill" Value="{DynamicResource MaterialPrimaryContainerBrush}"/>
  </Style>
  <Style Selector="ToggleSwitch:pressed /template/ Ellipse#SwitchKnobOff,
                   ToggleSwitch:pressed /template/ Ellipse#SwitchKnobOn">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
  </Style>
  <Style Selector="ToggleSwitch:focus-visible /template/ Grid#SwitchAreaGrid">
    <Setter Property="Background" Value="{DynamicResource MaterialPrimaryContainerBrush}"/>
  </Style>
  <Style Selector="ToggleSwitch:disabled">
    <Setter Property="Opacity" Value="0.38"/>
  </Style>
  <Style Selector="ToggleSwitch:disabled /template/ Border#OuterBorder">
    <Setter Property="Background" Value="{DynamicResource MaterialSurfaceContainerHighBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MaterialOutlineVariantBrush}"/>
  </Style>
  <Style Selector="ToggleSwitch:checked:disabled /template/ Border#SwitchKnobBounds">
    <Setter Property="Background" Value="{DynamicResource MaterialOnSurfaceVariantBrush}"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>

  <!-- The note inspector keeps its denser switch without changing its existing control. -->
  <Style Selector="c|NotePropertiesControl ToggleSwitch:checked,
                   c|NotePropertiesControl ToggleSwitch:unchecked">
    <Style Selector="^ /template/ Border#OuterBorder, ^ /template/ Border#SwitchKnobBounds">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="CornerRadius" Value="12"/>
    </Style>
    <Style Selector="^ /template/ Canvas#PART_SwitchKnob">
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="^ /template/ Grid#PART_MovingKnobs">
      <Setter Property="Width" Value="24"/>
      <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="^ /template/ Ellipse#SwitchKnobOff">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Height" Value="12"/>
    </Style>
    <Style Selector="^ /template/ Ellipse#SwitchKnobOn">
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
    </Style>
  </Style>
  <Style Selector="c|NotePropertiesControl ToggleSwitch:pressed /template/ Ellipse#SwitchKnobOff,
                   c|NotePropertiesControl ToggleSwitch:pressed /template/ Ellipse#SwitchKnobOn">
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="CornerRadius" Value="3"/>
  </Style>
  <Style Selector="CheckBox /template/ Grid#RootGrid">
    <Setter Property="Width" Value="NaN"/>
    <Setter Property="Height" Value="NaN"/>
  </Style>
  <Style Selector="CheckBox:not(.menu):checked /template/ Border#NormalRectangle,
                   CheckBox:not(.menu):unchecked /template/ Border#NormalRectangle,
                   CheckBox:not(.menu):indeterminate /template/ Border#NormalRectangle">
    <Setter Property="CornerRadius" Value="3"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <Style Selector="CheckBox:not(.menu):unchecked /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MaterialOnSurfaceVariantBrush}"/>
  </Style>
  <Style Selector="CheckBox:not(.menu):checked /template/ Border#NormalRectangle,
                   CheckBox:not(.menu):indeterminate /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MaterialPrimaryBrush}"/>
  </Style>
  <Style Selector="CheckBox:not(.menu):checked /template/ Path#CheckGlyph,
                   CheckBox:not(.menu):indeterminate /template/ Path#CheckGlyph">
    <Setter Property="Fill" Value="{DynamicResource MaterialOnPrimaryBrush}"/>
  </Style>
  <Style Selector="CheckBox:not(.menu):unchecked:pointerover /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource MaterialPrimaryContainerBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MaterialPrimaryBrush}"/>
  </Style>
  <Style Selector="CheckBox:not(.menu):checked:pointerover /template/ Border#NormalRectangle,
                   CheckBox:not(.menu):indeterminate:pointerover /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource MaterialPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MaterialPrimaryBrush}"/>
  </Style>
  <Style Selector="CheckBox:not(.menu):checked:pressed /template/ Border#NormalRectangle,
                   CheckBox:not(.menu):indeterminate:pressed /template/ Border#NormalRectangle">
    <Setter Property="Background" Value="{DynamicResource MaterialOnPrimaryContainerBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MaterialOnPrimaryContainerBrush}"/>
  </Style>
  <Style Selector="CheckBox:not(.menu):disabled">
    <Setter Property="Opacity" Value="0.38"/>
  </Style>
</Styles>
