<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:system="clr-namespace:System;assembly=mscorlib"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <system:Boolean x:Key="IsDarkMode">false</system:Boolean>

  <Color x:Key="BackgroundColor">#FFFBFE</Color>
  <Color x:Key="BackgroundColorPointerOver">#ECE6F0</Color>
  <Color x:Key="BackgroundColorPressed">#E8DEF8</Color>
  <Color x:Key="BackgroundColorDisabled">#E6E0E9</Color>

  <Color x:Key="ForegroundColor">#1D1B20</Color>
  <Color x:Key="ForegroundColorPointerOver">#1D1B20</Color>
  <Color x:Key="ForegroundColorPressed">#49454F</Color>
  <Color x:Key="ForegroundColorDisabled">#79747E</Color>

  <Color x:Key="BorderColor">#CAC4D0</Color>
  <Color x:Key="BorderColorPointerOver">#79747E</Color>

  <Color x:Key="SystemAccentColor">#6750A4</Color>
  <!-- PointerOver -->
  <Color x:Key="SystemAccentColorLight1">#7F67BE</Color>
  <!-- Pressed -->
  <Color x:Key="SystemAccentColorDark1">#4F378B</Color>

  <Color x:Key="NeutralAccentColor">#79747E</Color>
  <Color x:Key="NeutralAccentColorPointerOver">#625B71</Color>
  <Color x:Key="AccentColor1">#6750A4</Color>
  <Color x:Key="AccentColor2">#9C4267</Color>
  <Color x:Key="AccentColor3">#7D294E</Color>
  
  <Color x:Key="TickLineColor">#CAC4D0</Color>
  <Color x:Key="BarNumberColor">#625B71</Color>
  <Color x:Key="FinalPitchColor">#625B71</Color>
  <Color x:Key="TrackBackgroundAltColor">#F3EDF7</Color>

  <Color x:Key="WarningColor">#FFF0C2</Color>

  <!--Keyboard Background-->
  <Color x:Key="WhiteKeyColorLeft">#FFFBFE</Color>
  <Color x:Key="WhiteKeyColorRight">#FFFBFE</Color>
  <Color x:Key="WhiteKeyNameColor">#49454F</Color>

  <Color x:Key="CenterKeyColorLeft">#EADDFF</Color>
  <Color x:Key="CenterKeyColorRight">#EADDFF</Color>
  <Color x:Key="CenterKeyNameColor">#21005D</Color>

  <Color x:Key="BlackKeyColorLeft">#625B71</Color>
  <Color x:Key="BlackKeyColorRight">#625B71</Color>
  <Color x:Key="BlackKeyNameColor">#FFFFFF</Color>
</ResourceDictionary>
